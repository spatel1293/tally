{
  "name": "tally-budget",
  "version": "1.0.0",
  "private": true,
  "description": "A personal budgeting web app. Offline, private, no accounts, no AI.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:browser": "node scripts/browser-test.js",
    "build": "node scripts/build-single-file.js",
    "bridge": "node --env-file-if-exists=.env scripts/plaid-bridge.js",
    "build:site": "node scripts/build-site.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
