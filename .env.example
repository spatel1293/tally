# Copy this file to .env and fill in your own values from
# https://dashboard.plaid.com (Team Settings -> Keys). Never commit .env —
# it is already in .gitignore.

PLAID_CLIENT_ID=
PLAID_SECRET=

# "sandbox" for fake banks (free, unlimited, good for a first try) or
# "production" for real ones (free allowance: 200 live calls per product).
PLAID_ENV=sandbox
