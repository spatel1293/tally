{
  "name": "Tally Budget",
  "short_name": "Tally",
  "description": "A private, offline budgeting app.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "launch_handler": { "client_mode": "focus-existing" },
  "background_color": "#E8E8E3",
  "theme_color": "#E8E8E3",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add a transaction", "short_name": "Add", "url": "./#/?add=1" }
  ],
  "screenshots": [
    { "src": "icons/screenshots/narrow-home.png", "sizes": "412x915", "type": "image/png", "form_factor": "narrow", "label": "This month's spending, budgets and recent activity" },
    { "src": "icons/screenshots/wide-home.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "The laptop dashboard, with spending by category" }
  ]
}
